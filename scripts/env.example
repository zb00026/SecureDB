# ===================================================
# DAM Backup/Restore Configuration
# ===================================================
# Copy this file to .env and fill in your values
# Usage: source .env && ./backup.sh
#
# FOR LOCAL TESTING:
# - Use test databases (e.g., dam_test, keycloak_test)
# - Use a test S3 bucket or test prefix
# - Set KEEP_LOCAL_BACKUP=true to inspect backups locally
# - See scripts/README.md for detailed testing guide

# ===================================================
# Application Database Configuration
# ===================================================
# For local testing, use test database: DB_NAME=dam_test
DB_TYPE=mysql                    # mysql or postgresql
DB_HOST=localhost
DB_PORT=3306                     # 3306 for MySQL, 5432 for PostgreSQL
DB_NAME=dam                      # Use dam_test for local testing
DB_USER=root
DB_PASSWORD="your_password_here"  # Quotes are optional but recommended for passwords with special characters

# ===================================================
# Keycloak Database Configuration
# ===================================================
# Option 1: H2 Database (dev mode or production with H2)
# Set KEYCLOAK_DB_TYPE=h2 and provide Keycloak installation path
KEYCLOAK_DB_TYPE=h2             # h2, mysql, or postgresql
KEYCLOAK_HOME=/opt/keycloak     # Path to Keycloak installation (for H2)
KEYCLOAK_SERVICE_FILE=/etc/systemd/system/keycloak.service  # Alternative: path to systemd service file
KEYCLOAK_USER=keycloak          # User that runs Keycloak (for file permissions)
KEYCLOAK_BACKUP_WAIT=false      # Set to 'true' to wait 2 seconds before backup (production safety)

# Option 2: External Database (MySQL/PostgreSQL)
# Uncomment and configure if using external database:
# KEYCLOAK_DB_TYPE=mysql          # mysql or postgresql
# KEYCLOAK_DB_HOST=localhost
# KEYCLOAK_DB_PORT=3306
# KEYCLOAK_DB_NAME=keycloak       # Use keycloak_test for local testing
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=your_keycloak_password_here

# ===================================================
# AWS S3 Configuration
# ===================================================
# For local testing, use a test bucket or test prefix to separate from production
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=dam-backups
S3_REGION=ap-south-1
S3_PREFIX=dam-backups/           # Optional: prefix for backup files in S3
                                 # For testing, use: test-backups/
S3_STORAGE_CLASS=STANDARD_IA     # Optional: STANDARD, STANDARD_IA, GLACIER, etc.

# ===================================================
# Restore Configuration (for restore.sh only)
# ===================================================
# Full S3 path to the backup file to restore
# Example: s3://dam-backups/dam-backups/dam_backup_20231120_143000.tar.gz
S3_BACKUP_PATH=

# Set to 'true' to drop and recreate databases before restore
RECREATE_DB=false

# Set to 'true' to skip confirmation prompt (use with caution!)
FORCE_RESTORE=false

# Set to 'true' to keep downloaded backup after restore
KEEP_DOWNLOADED_BACKUP=false

# ===================================================
# Backup Configuration (for backup.sh only)
# ===================================================
# Set to 'true' to keep local backup file after upload
# Recommended: true for local testing, false for production
KEEP_LOCAL_BACKUP=false

# Auto-install AWS CLI if not found (default: true)
# Set to 'false' to disable automatic installation
AUTO_INSTALL_AWSCLI=true

# Auto-fix broken AWS CLI installations (default: true)
# If AWS CLI is installed but broken (Python compatibility issues), automatically fix it
AUTO_FIX_AWSCLI=true

# Skip confirmation prompt for AWS CLI installation (default: false)
# Set to 'true' to automatically install without asking
FORCE_INSTALL_AWSCLI=false

# ===================================================
# Optional: Slack Notifications
# ===================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

