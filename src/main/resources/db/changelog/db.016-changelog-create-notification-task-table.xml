<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="create_notification_task_table" author="your_name">
        <createTable tableName="notification_task">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="receiver_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notification_task_receiver" references="users(id)"/>
            </column>
            <column name="requestor_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notification_task_requestor" references="users(id)"/>
            </column>
            <column name="asset_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notification_task_asset" references="assets(id)"/>
            </column>
            <column name="notification_message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="make_asset_id_nullable" author="admin">
        <dropForeignKeyConstraint baseTableName="notification_task" constraintName="fk_notification_task_asset"/>
        <dropNotNullConstraint tableName="notification_task" columnName="asset_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="notification_task"
                                 baseColumnNames="asset_id"
                                 constraintName="fk_notification_task_asset"
                                 referencedTableName="assets"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>