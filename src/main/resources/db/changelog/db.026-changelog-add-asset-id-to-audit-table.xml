<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="add-asset-id-to-audit-trails" author="verlake">
        <addColumn tableName="audit_trails">
            <column name="asset_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="audit_trails" indexName="idx_audit_trails_asset_id">
            <column name="asset_id"/>
        </createIndex>
        
        <rollback>
            <dropIndex tableName="audit_trails" indexName="idx_audit_trails_asset_id"/>
            <dropColumn tableName="audit_trails" columnName="asset_id"/>
        </rollback>
    </changeSet>

    <changeSet id="add-is-locked-to-assets" author="verlake">
        <addColumn tableName="assets">
            <column name="is_locked" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="assets" indexName="idx_assets_is_locked">
            <column name="is_locked"/>
        </createIndex>
        
        <rollback>
            <dropIndex tableName="assets" indexName="idx_assets_is_locked"/>
            <dropColumn tableName="assets" columnName="is_locked"/>
        </rollback>
    </changeSet>

    <changeSet id="add-lock-type-to-assets" author="verlake">
        <addColumn tableName="assets">
            <column name="lock_type" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="assets" indexName="idx_assets_lock_type">
            <column name="lock_type"/>
        </createIndex>
        
        <rollback>
            <dropIndex tableName="assets" indexName="idx_assets_lock_type"/>
            <dropColumn tableName="assets" columnName="lock_type"/>
        </rollback>
    </changeSet>
    
</databaseChangeLog> 