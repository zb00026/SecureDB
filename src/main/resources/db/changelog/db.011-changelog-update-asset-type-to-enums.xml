<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">


    <changeSet id="update-asset-type-enums" author="admin">
        <!-- Update assets table -->
        <modifyDataType tableName="assets" 
                       columnName="type" 
                       newDataType="ENUM('DATABASE')"/>
        
        <modifyDataType tableName="assets" 
                       columnName="database_type" 
                       newDataType="ENUM('MYSQL', 'POSTGRESQL', 'ORACLE', 'SQLSERVER')"/>
    </changeSet>



    <!-- Update existing data if needed -->
    <changeSet id="update-existing-data" author="admin">
        <!-- Update any MSSQL values to SQLSERVER -->
        <update tableName="access_levels">
            <column name="database_type" value="SQLSERVER"/>
            <where>database_type = 'MSSQL'</where>
        </update>
        
        <update tableName="assets">
            <column name="database_type" value="SQLSERVER"/>
            <where>database_type = 'MSSQL'</where>
        </update>
    </changeSet>

    <changeSet id="update-access-levels-enums" author="admin">
        <!-- Update access_levels table -->
        <modifyDataType tableName="access_levels" 
                       columnName="asset_type" 
                       newDataType="ENUM('DATABASE')"/>
        
        <modifyDataType tableName="access_levels" 
                       columnName="database_type" 
                       newDataType="ENUM('MYSQL', 'POSTGRESQL', 'ORACLE', 'SQLSERVER')"/>
    </changeSet>

    <changeSet id="update-access-requests-enums" author="admin">
        <!-- Update access_requests table -->
        <modifyDataType tableName="access_requests" 
                       columnName="developer_approver_status" 
                       newDataType="ENUM('PENDING', 'APPROVED', 'REJECTED', 'CANCELLED')"/>
        
        <modifyDataType tableName="access_requests" 
                       columnName="asset_approver_status" 
                       newDataType="ENUM('PENDING', 'APPROVED', 'REJECTED', 'CANCELLED')"/>
    </changeSet>

    <!-- Add default values for approval status columns -->
    <changeSet id="add-default-values" author="admin">
        <addDefaultValue tableName="access_requests"
                        columnName="developer_approver_status"
                        defaultValue="PENDING"/>
        
        <addDefaultValue tableName="access_requests"
                        columnName="asset_approver_status"
                        defaultValue="PENDING"/>
    </changeSet>
</databaseChangeLog> 