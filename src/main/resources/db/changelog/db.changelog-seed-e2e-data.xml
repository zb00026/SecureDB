<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Wipe existing data if flag is set -->
    <changeSet id="wipe-data" author="admin" context="e2e-data">
        <preConditions onFail="MARK_RAN">
            <changeLogPropertyDefined property="wipe.data" value="true"/>
        </preConditions>
        
        <sql>
            SET FOREIGN_KEY_CHECKS = 0;
            TRUNCATE TABLE audit_trails;
            TRUNCATE TABLE user_roles;
            TRUNCATE TABLE users;
            TRUNCATE TABLE s3_bucket_settings;
            SET FOREIGN_KEY_CHECKS = 1;
        </sql>
    </changeSet>

    <!-- Seed E2E test data -->
    <changeSet id="seed-e2e-data" author="admin" context="e2e-data">

        <!-- Create E2E test users -->
        <insert tableName="users">
            <column name="email" value="admin@admin.com"/>
            <column name="first_name" value="E2E"/>
            <column name="last_name" value="Admin"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="user_roles">
            <column name="user_id" value="1"/>
            <column name="role_id" value="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>