<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="add-credential-user-type" author="admin">
        <!-- Add user access type column -->
        <addColumn tableName="asset_credentials">
            <column name="user_access_type" type="varchar(50)" defaultValue="Asset Owner">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add comment to explain the column -->
        <sql>
            ALTER TABLE asset_credentials 
            MODIFY COLUMN user_access_type varchar(50) 
            COMMENT 'Type of user access: Admin, Developer, Asset Owner, Approver, Auditor, User';
        </sql>
    </changeSet>

    <changeSet id="rename-requestor-to-sender" author="admin">
        <!-- First, drop the foreign key constraint -->
        <sql>
            SET FOREIGN_KEY_CHECKS = 0;
        </sql>

        <dropForeignKeyConstraint baseTableName="notification_task" constraintName="fk_notification_task_requestor"/>

        <!-- Rename requestor_id to sender_id in notification_task table -->
        <renameColumn tableName="notification_task" 
                     oldColumnName="requestor_id" 
                     newColumnName="sender_id" 
                     columnDataType="BIGINT"/>
        
        <!-- Add the new foreign key constraint -->
        <addForeignKeyConstraint baseTableName="notification_task"
                               baseColumnNames="sender_id"
                               constraintName="fk_notification_task_sender"
                               referencedTableName="users"
                               referencedColumnNames="id"/>

        <sql>
            SET FOREIGN_KEY_CHECKS = 1;
        </sql>
    </changeSet>

    <changeSet id="add-email-type-to-notification-task" author="admin">
        <!-- Add email type column -->
        <addColumn tableName="notification_task">
            <column name="email_type" type="varchar(50)" defaultValue="OTHER">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add comment to explain the column -->
        <sql>
            ALTER TABLE notification_task 
            MODIFY COLUMN email_type varchar(50) 
            COMMENT 'Type of email notification: INVITATION, RELINQUISH_ASSET_CREDENTIAL, ASSET_APPROVE_NOTIFY, DEVELOPER_ASSET_REQUEST_NOTIFY, OTHER';
        </sql>
    </changeSet>

    <changeSet id="update email type for approval access request" author="admin">
        <modifyDataType tableName="emails" columnName="email_type" newDataType="ENUM('INVITATION', 'OTHER', 'RELINQUISH_ASSET_CREDENTIAL', 'ASSET_APPROVE_NOTIFY', 'DEVELOPER_ASSET_REQUEST_NOTIFY', 'APPROVAL_ASSET_ACCESS_REQUEST')"/>
    </changeSet>

    <changeSet id="add-is-sent-to-notification-task" author="admin">
        <!-- Add is_sent column -->
        <addColumn tableName="notification_task">
            <column name="is_sent" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add comment to explain the column -->
        <sql>
            ALTER TABLE notification_task 
            MODIFY COLUMN is_sent boolean 
            COMMENT 'Flag to indicate if the notification has been sent';
        </sql>
    </changeSet>

</databaseChangeLog> 