<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="add-is-temp-password-to-access-requests" author="admin">
        <addColumn tableName="access_requests">
            <column name="is_temp_password" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="access_requests">
            <column name="asset_credential_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-foreign-key-constraint" author="admin">
        <addForeignKeyConstraint baseTableName="access_requests"
                                 baseColumnNames="asset_credential_id"
                                 constraintName="fk_access_requests_asset_credential"
                                 referencedTableName="asset_credentials"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog> 