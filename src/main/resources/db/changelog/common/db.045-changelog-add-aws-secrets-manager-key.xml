<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Add AWS Secrets Manager key field to asset_credentials table -->
    <changeSet id="add-aws-secrets-manager-key-to-asset-credentials" author="admin">
        <comment>Add aws_secrets_manager_key field to asset_credentials table for AWS Secrets Manager integration</comment>
        <addColumn tableName="asset_credentials">
            <column name="aws_secrets_manager_key" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>




