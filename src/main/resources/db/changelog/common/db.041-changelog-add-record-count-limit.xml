<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="add-record-count-limit-column" author="system">
        <comment>Add record_count_limit column to assets table with default value 50</comment>
        
        <addColumn tableName="assets">
            <column name="record_count_limit" type="int" defaultValue="50">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
    </changeSet>

</databaseChangeLog>
