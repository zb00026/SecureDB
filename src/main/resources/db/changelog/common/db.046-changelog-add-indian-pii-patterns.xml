    <changeSet id="046-add-indian-pii-patterns-pan" author="system">
        <comment>Add Indian PII patterns: PAN (Permanent Account Number) and Aadhaar for data masking detection</comment>
        
        <!-- PAN (Permanent Account Number) - Indian tax ID, format: AAAAA9999A -->
        <insert tableName="ai_sensitive_patterns">
            <column name="pattern_key" value="pan"/>
            <column name="pattern_name" value="PAN (Indian Permanent Account Number)"/>
            <column name="pattern_description" value="Detects Indian PAN (Permanent Account Number) fields"/>
            <column name="pattern_regex" value="pan"/>
            <column name="masking_strategy" value="partial"/>
            <column name="detection_reason" value="Indian PAN (Permanent Account Number) field detected"/>
            <column name="sensitivity_level" value="HIGH"/>
            <column name="pattern_category" value="PAN"/>
            <column name="is_active" valueNumeric="1"/>
            <column name="confidence_score" valueNumeric="0.9"/>
            <column name="preserve_chars" valueNumeric="4"/>
            <column name="mask_char" value="*"/>
            <column name="sample_value" value="ABCDE****A"/>
            <column name="version" valueNumeric="1"/>
            <column name="created_at" valueDate="NOW()"/>
            <column name="updated_at" valueDate="NOW()"/>
            <column name="created_by" value="system"/>
        </insert>

        <insert tableName="ai_sensitive_patterns">
            <column name="pattern_key" value="pan_number"/>
            <column name="pattern_name" value="PAN Number Pattern"/>
