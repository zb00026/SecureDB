<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="db.032-create-ai-categories-table" author="system">
        <comment>Create ai_categories table for database-driven category detection</comment>
        
        <!-- Create table -->
        <createTable tableName="ai_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category_key" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="keywords" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="field_patterns" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sensitivity_level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="TINYINT(1)" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_by" type="VARCHAR(100)"/>
        </createTable>
        
        <!-- Add indexes -->
        <createIndex tableName="ai_categories" indexName="idx_ai_categories_key">
            <column name="category_key"/>
        </createIndex>
        <createIndex tableName="ai_categories" indexName="idx_ai_categories_active">
            <column name="is_active"/>
        </createIndex>
        <createIndex tableName="ai_categories" indexName="idx_ai_categories_priority">
            <column name="priority"/>
        </createIndex>
    </changeSet>

    <changeSet id="db.032-add-category-id-to-ai-sensitive-patterns" author="system">
        <comment>Add category_id column to ai_sensitive_patterns table to support relationship with ai_categories</comment>
        
        <!-- Add category_id column -->
        <addColumn tableName="ai_sensitive_patterns">
            <column name="category_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <!-- Add foreign key constraint -->
        <addForeignKeyConstraint 
            baseTableName="ai_sensitive_patterns" 
            baseColumnNames="category_id" 
            constraintName="fk_ai_sensitive_patterns_category_id" 
            referencedTableName="ai_categories" 
            referencedColumnNames="id" 
            onDelete="SET NULL"/>
        
        <!-- Add index for better performance -->
        <createIndex tableName="ai_sensitive_patterns" indexName="idx_ai_sensitive_patterns_category_id">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

