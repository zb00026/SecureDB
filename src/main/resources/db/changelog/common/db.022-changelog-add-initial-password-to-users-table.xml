<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-initial-password-column" author="admin">
        <addColumn tableName="users">
            <column name="is_initial_password" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    
    <changeSet id="update-initial-password-column" author="admin">
        <update tableName="users">
            <column name="is_initial_password" valueBoolean="false"/>
            <where>id = 1</where>
        </update>
    </changeSet>
    <changeSet id="add-is-temporary-password-column-to-asset-credentials" author="admin">
        <addColumn tableName="asset_credentials">
            <column name="is_temporary_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog> 