            <column name="asset_type" value="DATABASE"/>
            <column name="database_type" value="MYSQL"/>
            <column name="object" value="TABLE"/>
            <column name="templates" value="SELECT"/>
            <column name="access_template" value="GRANT SELECT ON $DB.$TABLE TO '$USER'@'%';"/>
        </insert>
