            <column name="templates" value="FULL ACCESS"/>
            <column name="access_template" value="GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, CREATE VIEW, SHOW VIEW, TRIGGER, REFERENCES, EXECUTE ON $DB.* TO '$USER'@'%';"/>
