<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Log path and log pattern configuration -->
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %-40.40logger{39} : %msg%n%throwable" />

    <!-- Console appender with ANSI colors -->
    <appender name="consoleLog" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%thread] %magenta(%-5level) %green([%-50.50class]) >>> %cyan(%msg) %n
            </pattern>
        </encoder>
    </appender>

    <!-- File appender with TimeBasedRollingPolicy (removes the %i pattern) -->
    <appender name="fileLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/cms.log</file> <!-- Base log file name -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Roll files based on date (daily rotation) -->
            <fileNamePattern>${LOG_PATH}/cms.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- Retain 30 days of logs -->
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Elastic appender using JSON format for sending logs to Logstash -->
    <appender name="ElasticAppender" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${HOST_IP_ADDRESS}:12324</destination> <!-- Logstash endpoint -->
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <mdc /> <!-- Add MDC (Mapped Diagnostic Context) values to the log -->
                <pattern>
                    {"@timestamp":"%date{ISO8601}","@version":"1","DAM-Hagrid-message":"%msg","logger":"%logger","level":"%level","thread":"%thread"}
                </pattern>
                <!-- Stack trace conversion for better handling of exceptions -->
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <exclude>^sun\.reflect\..*\.invoke</exclude>
                        <exclude>^net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="consoleLog" />
        <appender-ref ref="fileLog" />
        <appender-ref ref="ElasticAppender" />
    </root>

    <!-- Optional logger for your specific package (com.verlake.dam) -->
    <logger name="com.verlake.dam" level="DEBUG" additivity="false">
        <appender-ref ref="consoleLog" />
        <appender-ref ref="fileLog" />
        <appender-ref ref="ElasticAppender" />
    </logger>

    <!-- Logger for elastic apm -->
    <logger name="co.elastic.apm" level="INFO" additivity="false">
        <appender-ref ref="consoleLog" />
    </logger>

</configuration>